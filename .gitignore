.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
*.env
.env
kubeconfig
*.kubeconfig
.DS_Store

# Captured cross-stage outputs (scripts/03/04-apply-*.sh) -- regenerated
# on every apply, and can carry secret values (e.g. postgres admin secret
# names/hosts) through the -var-file chain, so this is state, not source.
terraform/generated/

# Local, machine-specific variable overrides (e.g.
# terraform/providers/baremetal/terraform.tfvars holding your box's own
# IP/SSH user) -- these differ per person/machine running this repo and
# aren't source either. Committed *.tfvars.example files are the template
# instead; *.tfvars.json is already covered by terraform/generated/ above.
*.tfvars

# scripts/03-apply-provider.sh's Option A tenant-discovery step (see that
# script's own header comment) -- regenerated on every run from
# terraform/tenants/*'s real directory names, same "generated, not
# committed" treatment as terraform/generated/ above, just living inside
# the provider module itself so tofu auto-loads it without a -var-file flag.
terraform/providers/*/tenant_ids.auto.tfvars.json

# scripts/03-apply-provider.sh's two-phase EKS-admin-identity bootstrap
# (AWS only -- see terraform/providers/aws/iam.tf's aws_iam_user.eks_admin
# header comment). Same "generated, not committed" treatment as
# tenant_ids.auto.tfvars.json above, and it holds a live (if only
# floci-emulated) access key, so it shouldn't be committed even if it
# weren't regenerated every run.
terraform/providers/*/eks_admin.auto.tfvars.json

# dbt/'s own venv and generated run artifacts (scripts/07-run-dbt-local.sh)
# -- regenerated on every run, machine-specific, not source.
dbt/.venv/
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Gradle build output and caches for kestra-plugins/* (were committed
# upstream; regenerated by every build, not source).
build/
.gradle/
*.swp

# Per-run output of scripts/03-apply-provider.sh; debug.log echoes the
# emulated EKS admin key, so never commit this folder.
terraform/providers/*/generated/
